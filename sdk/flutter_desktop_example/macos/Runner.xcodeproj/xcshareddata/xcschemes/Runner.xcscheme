            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Copy codex_ffi dylib into the app bundle"
               scriptText = "set -e&#10;LIB=&quot;${SRCROOT}/../../../codex-rs/target/debug/libcodex_ffi.dylib&quot;&#10;if [ &quot;${CONFIGURATION}&quot; = &quot;Release&quot; ] || [ &quot;${CONFIGURATION}&quot; = &quot;Profile&quot; ]; then&#10;  LIB=&quot;${SRCROOT}/../../../codex-rs/target/release/libcodex_ffi.dylib&quot;&#10;fi&#10;DEST=&quot;${TARGET_BUILD_DIR}/${EXECUTABLE_FOLDER_PATH}/../Frameworks&quot;&#10;mkdir -p &quot;$DEST&quot;&#10;if [ -f &quot;$LIB&quot; ]; then&#10;  cp -f &quot;$LIB&quot; &quot;$DEST/libcodex_ffi.dylib&quot;&#10;else&#10;  echo &quot;warning: libcodex_ffi.dylib not found at $LIB&quot; &gt;&amp;2&#10;fi&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "33CC10EC2044A3C60003C045"
                     BuildableName = "flutter_desktop_example.app"
                     BlueprintName = "Runner"
                     ReferencedContainer = "container:Runner.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PostActions>
